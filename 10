"""
Backward Chaining Planner with Unification (Prolog/PDDL style)

Supports:
- Variable unification (?x, ?y, etc.)
- Partial effect matching (action needs at least one relevant effect)
- Substitution propagation through the plan
- Cumulative state tracking (effects of planned actions enrich the state)
- A* search mode with action costs and heuristic guidance
"""

import heapq
from typing import Optional


# --- Unification ---

def is_var(term) -> bool:
    """Check if a term is a variable (starts with ?)."""
    return isinstance(term, str) and term.startswith("?")


def walk(term, subst: dict):
    """Resolve a term through substitution chain to its final value."""
    seen = set()
    while is_var(term) and term in subst and term not in seen:
        seen.add(term)
        term = subst[term]
    
    if isinstance(term, tuple):
        return tuple(walk(t, subst) for t in term)
    if isinstance(term, list):
        return [walk(t, subst) for t in term]
    return term


def unify(t1, t2, subst: dict) -> Optional[dict]:
    """Unify two terms under existing substitutions. Returns new subst or None."""
    t1 = walk(t1, subst)
    t2 = walk(t2, subst)
    
    if t1 == t2:
        return subst
    
    if is_var(t1):
        return {**subst, t1: t2}
    if is_var(t2):
        return {**subst, t2: t1}
        
    if isinstance(t1, (tuple, list)) and isinstance(t2, (tuple, list)):
        if len(t1) != len(t2):
            return None
        for a, b in zip(t1, t2):
            subst = unify(a, b, subst)
            if subst is None:
                return None
        return subst
        
    return None


def apply_subst(predicates: list, subst: dict) -> list:
    """Apply substitution to all terms in a list of predicates."""
    return [walk(p, subst) for p in predicates]


# --- Planner ---

class Action:
    def __init__(self, name: str, params: list, preconditions: list, effects: list, cost: float = 1.0):
        self.name = name
        self.params = params
        self.pre = preconditions
        self.eff = effects
        self.cost = cost

    def fresh(self, counter: int) -> "Action":
        """Create a fresh copy with renamed variables to avoid capture."""
        rename = {p: f"{p}_{counter}" for p in self.params}
        a = Action(
            self.name,
            [rename[p] for p in self.params],
            apply_subst(self.pre, rename),
            apply_subst(self.eff, rename),
            self.cost,
        )
        return a


_counter = 0

def _next_id():
    global _counter
    _counter += 1
    return _counter


def _matches_any(goal, state, subst):
    """Try to unify goal with any fact in state. Returns updated subst or None."""
    for fact in state:
        result = unify(goal, fact, subst)
        if result is not None:
            return result
    return None


def backward_chain(
    goals: list,
    actions: list[Action],
    state: set,
    depth: int = 20,
    subst: dict | None = None,
) -> Optional[tuple[list[tuple[str, dict]], dict]]:
    """
    Backward chaining with unification and cumulative state.
    Returns (plan, final_substitution) or None.
    
    Args:
        goals: List of goal predicates to achieve
        actions: List of available Action schemas
        state: Set of facts currently true
        depth: Maximum search depth
        subst: Current variable substitution (internal use)
        
    Returns:
        Tuple of (plan, final_subst) where plan is list of (action_name, bindings),
        or None if no solution found.
    """
    if subst is None:
        subst = {}

    # Partition goals into satisfied and unsatisfied
    current_subst = subst
    unsatisfied = []
    
    for g in goals:
        resolved = walk(g, current_subst)
        result = _matches_any(resolved, state, current_subst)
        if result is not None:
            current_subst = result
        else:
            unsatisfied.append(g)

    # Base case: all goals satisfied
    if not unsatisfied:
        return ([], current_subst)

    # Depth limit reached
    if depth == 0:
        return None

    # Pick first unsatisfied goal to work on
    target = walk(unsatisfied[0], current_subst)

    # Try each action that could achieve this goal
    for action in actions:
        fresh_action = action.fresh(_next_id())

        # Check if any effect of this action can match our target goal
        for eff in fresh_action.eff:
            new_subst = unify(eff, target, current_subst.copy())
            if new_subst is None:
                continue

            # Add preconditions as new subgoals + remaining unsatisfied goals
            new_pre = apply_subst(fresh_action.pre, new_subst)
            remaining = apply_subst(unsatisfied[1:], new_subst)
            new_goals = new_pre + remaining

            # After this action executes, its effects become part of the state
            new_effects = set(apply_subst(fresh_action.eff, new_subst))
            expanded_state = state | new_effects

            # Recursively solve for the new goals
            result = backward_chain(new_goals, actions, expanded_state, depth - 1, new_subst)
            if result is not None:
                sub_plan, final_subst = result
                
                # Resolve action parameters with final substitution
                resolved_params = apply_subst(fresh_action.params, final_subst)
                step = (fresh_action.name, dict(zip(action.params, resolved_params)))
                
                return (sub_plan + [step], final_subst)

    return None


def backward_chain_astar(
    goals: list,
    actions: list[Action],
    state: set,
) -> Optional[tuple[list[tuple[str, dict]], dict, float]]:
    """
    A* backward chaining with unification and action costs.
    Finds the lowest-cost plan. Returns (plan, final_subst, total_cost) or None.
    
    Heuristic: number of unsatisfied goals (admissible for unit-cost actions).
    
    Args:
        goals: List of goal predicates to achieve
        actions: List of available Action schemas with costs
        state: Set of facts currently true
        
    Returns:
        Tuple of (plan, final_subst, total_cost) or None if no solution.
    """
    counter = 0

    def make_node(goals, subst, expanded_state, plan, g_cost):
        nonlocal counter
        counter += 1
        
        # Heuristic: count unsatisfied goals
        h = 0
        for g in goals:
            resolved = walk(g, subst)
            if _matches_any(resolved, expanded_state, subst) is None:
                h += 1
        
        return (g_cost + h, counter, goals, subst, expanded_state, plan, g_cost)

    start = make_node(goals, {}, state, [], 0.0)
    frontier = [start]
    visited = set()

    while frontier:
        f, _, cur_goals, cur_subst, cur_state, cur_plan, g = heapq.heappop(frontier)

        # Determine which goals are still unsatisfied
        remaining_subst = cur_subst
        unsatisfied = []
        for goal in cur_goals:
            resolved = walk(goal, remaining_subst)
            result = _matches_any(resolved, cur_state, remaining_subst)
            if result is not None:
                remaining_subst = result
            else:
                unsatisfied.append(goal)

        # Goal test: all goals satisfied?
        if not unsatisfied:
            return (cur_plan, remaining_subst, g)

        # Check if we've seen this goal configuration before
        sig_goals = tuple(sorted(str(walk(u, remaining_subst)) for u in unsatisfied))
        if sig_goals in visited:
            continue
        visited.add(sig_goals)

        target = walk(unsatisfied[0], remaining_subst)

        # Generate successors by trying each action
        for action in actions:
            fresh_action = action.fresh(_next_id())

            for eff in fresh_action.eff:
                new_subst = unify(eff, target, remaining_subst.copy())
                if new_subst is None:
                    continue

                # Create new goals from preconditions + remaining unsatisfied
                new_pre = apply_subst(fresh_action.pre, new_subst)
                remaining = apply_subst(unsatisfied[1:], new_subst)
                new_goals = new_pre + remaining

                # Expand state with this action's effects
                new_effects = set(apply_subst(fresh_action.eff, new_subst))
                expanded_state = cur_state | new_effects

                # Create plan step with resolved parameters
                resolved_params = apply_subst(fresh_action.params, new_subst)
                step = (fresh_action.name, dict(zip(action.params, resolved_params)))
                new_plan = cur_plan + [step]
                new_g = g + action.cost

                node = make_node(new_goals, new_subst, expanded_state, new_plan, new_g)
                heapq.heappush(frontier, node)

    return None


def format_plan(plan: list[tuple[str, dict]], subst: dict | None = None) -> None:
    """Pretty-print a plan with variable bindings resolved."""
    for i, (name, bindings) in enumerate(plan, 1):
        if subst:
            bindings = {k: walk(v, subst) for k, v in bindings.items()}
        
        bound = {k: v for k, v in bindings.items() if not is_var(v)}
        if bound:
            args = ", ".join(f"{k}={v}" for k, v in bound.items())
            print(f"  {i}. {name}({args})")
        else:
            print(f"  {i}. {name}()")
