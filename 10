def test_unification_basics():
    """Test basic unification functionality."""
    print("Testing unification basics...")
    
    # Test 1: Identical terms unify trivially
    subst = {}
    result = unify(("at", "table"), ("at", "table"), subst)
    assert result is not None, "Identical terms should unify"
    
    # Test 2: Variable unifies with any term
    subst = {}
    result = unify("?x", "block_A", subst)
    assert result is not None and result["?x"] == "block_A"
    
    # Test 3: Two variables unify to each other
    subst = {}
    result = unify("?x", "?y", subst)
    assert result is not None
    assert (result["?x"] == "?y") or (is_var(result.get("?x")) and result.get("?x") in result)
    
    # Test 4: Incompatible terms fail to unify
    result = unify(("at", "table"), ("on", "shelf"), {})
    assert result is None, "Incompatible tuples should not unify"
    
    # Test 5: Nested structure unification
    subst = {}
    t1 = [("move", "?x", "?y"), ("clear", "?z")]
    t2 = [("move", "A", "B"), ("clear", "C")]
    result = unify(t1, t2, subst)
    assert result is not None
    
    print("✓ Unification basics passed\n")


def test_walk_function():
    """Test the walk function for substitution resolution."""
    print("Testing walk function...")
    
    # Test 1: Non-variable passes through unchanged
    assert walk("table", {}) == "table"
    assert walk(("at", "x"), {}) == ("at", "x")
    
    # Test 2: Variable with substitution resolves
    subst = {"?x": "block_A"}
    assert walk("?x", subst) == "block_A"
    
    # Test 3: Chained substitutions resolve completely
    subst = {"?x": "?y", "?y": "final_value"}
    assert walk("?x", subst) == "final_value"
    
    print("✓ Walk function passed\n")


def test_simple_planning_no_variables():
    """Test planning without variables (backward compatibility)."""
    print("Testing simple planning without variables...")
    
    actions = [
        # Action(name, params, preconditions, effects)
        Action("heat_oven", [], [], [("hot", "oven")]),
        Action("add_dough", [], [("hot", "oven")], [("baking", "pizza"), ("dough_in_oven", "x")]),
    ]
    
    initial_state = set()  # Nothing initially true
    
    goals = [("ready", "pizza")]
    
    # This should fail since no action achieves ("ready", "pizza")
    result = backward_chain(goals, actions, initial_state)
    assert result is None or result[0] == [], f"Expected no plan, got: {result}"

    # Positive case: goal that IS achievable without variables
    goals2 = [("baking", "pizza")]
    result2 = backward_chain(goals2, actions, initial_state)
    assert result2 is not None, "Should find a plan for (\"baking\", \"pizza\")."
    plan2, subst2 = result2
    print(f"  Achievable goal plan: {[name for name, _ in plan2]}")
    format_plan(plan2, subst2)
    
    print("✓ Simple planning test passed\n")


def test_planning_with_variables():
    """Test planning with variable unification."""
    print("Testing planning with variables...")
    
    # Block world scenario
    actions = [
        Action(
            name="move_block",
            params=["?block"],
            preconditions=[("on_table", "?block"), ("clear", "?block")],
            effects=[("in_hand", "?block"), ("not_on_table", "?block")]
        ),
        Action(
            name="place_block", 
            params=["?block"],
            preconditions=[("in_hand", "?block"), ("empty_spot", "shelf_1")],
            effects=[("on_shelf", "?block", "shelf_1")]
        )
    ]
    
    initial_state = {
        ("on_table", "A"),
        ("clear", "A"),
        ("empty_spot", "shelf_1")
    }
    
    goals = [("on_shelf", "?x", "shelf_1")]  # Some block on shelf_1
    
    result = backward_chain(goals, actions, initial_state)
    assert result is not None, "Should find a plan with variable ?x"
    plan, subst = result
    
    if plan:
        print(f"  Found plan with {len(plan)} steps")
        format_plan(plan, subst)
        
        # Verify the plan makes sense
        assert len(plan) >= 2, "Should need at least 2 actions"
        
        # Check variable binding for ?x
        if "?x" in subst:
            resolved_x = walk("?x", subst)
            print(f"  Variable ?x bound to: {resolved_x}")
    else:
        print("  No plan found (may be expected depending on action definitions)")
    
    print("✓ Planning with variables test completed\n")


def test_astar_with_costs():
    """Test A* search prefers cheaper actions."""
    print("Testing A* with costs...")
    
    # Two ways to achieve a goal, one cheaper than the other
    actions = [
        Action(
            name="cheap_method",
            params=[],
            preconditions=[("resource_A",)],
            effects=[("goal_achieved",)],
            cost=1.0  # Cheap!
        ),
        Action(
            name="expensive_method", 
            params=[],
            preconditions=[("resource_B",)],
            effects=[("goal_achieved",)],
            cost=5.0  # Expensive!
        )
    ]
    
    initial_state = {("resource_A",), ("resource_B",)}
    goals = [("goal_achieved",)]
    
    result = backward_chain_astar(goals, actions, initial_state)
    assert result is not None, "A* should find a plan"
    plan, subst, cost = result
    
    if plan:
        print(f"  A* found plan with total cost: {cost}")
        
        # Should prefer the cheap method
        action_names = [name for name, _ in plan]
        assert "cheap_method" in action_names or cost <= 1.0, \
            f"A* should prefer cheaper actions, got cost={cost}"
    else:
        print("  No plan found")
    
    print("✓ A* with costs test completed\n")


def test_substitution_propagation():
    """Test that substitutions propagate through the plan."""
    print("Testing substitution propagation...")
    
    # Chain of actions where each depends on previous variable bindings
    actions = [
        Action(
            name="step1",
            params=["?x"],
            preconditions=[("start_with", "?x")],
            effects=[("intermediate", "?x")]
        ),
        Action(
            name="step2",
            params=["?y"], 
            preconditions=[("intermediate", "?y"), ("needs_value", "42")],
            effects=[("final_result", "?y", "42")]
        )
    ]
    
    initial_state = {
        ("start_with", "value_A"),
        ("needs_value", "42")
    }
    
    goals = [("final_result", "?z", "42")]
    
    result = backward_chain(goals, actions, initial_state)
    assert result is not None, "Should find a chained plan with variable propagation"
    plan, subst = result
    
    if plan:
        print(f"  Plan found with {len(plan)} steps")
        format_plan(plan, subst)
        
        # Verify all parameters resolved to concrete values through the chain
        all_bindings = [walk(v, subst) for _, b in plan for v in b.values()]
        assert all(not is_var(x) for x in all_bindings), \
            f"Variables should resolve to concrete values, got: {all_bindings}"
        print(f"  All variables resolved: {all_bindings}")
    else:
        print("  No plan found")
    
    print("✓ Substitution propagation test completed\n")


def test_edge_cases():
    """Test edge cases and error conditions."""
    print("Testing edge cases...")
    
    # Test 1: Empty goals should return empty plan immediately
    actions = []
    state = set()
    plan, subst = backward_chain([], actions, state)
    assert plan == [], "Empty goals should give empty plan"
    print("  ✓ Empty goals handled")
    
    # Test 2: Impossible goal with no matching actions
    actions = [Action("do_nothing", [], [], [("nothing",)])]
    state = set()
    result = backward_chain([("impossible_goal",)], actions, state)
    assert result is None or result[0] == [], "Impossible goals should fail"
    print("  ✓ Impossible goal handled")
    
    # Test 3: Depth limit prevents infinite recursion (must terminate cleanly)
    import time
    actions = [Action("loop", ["?x"], [("next_state", "?x")], [("current_state", "?x")])]
    state = {("start",)}
    t0 = time.time()
    result = backward_chain([("end_state",)], actions, state, depth=2)
    elapsed = time.time() - t0
    assert elapsed < 5.0, f"Depth limit failed to bound search (took {elapsed:.1f}s)"
    print(f"  ✓ Depth limit works (terminated in {elapsed*1000:.1f}ms)")
    
    print("\n✓ All edge cases passed\n")


